# Copy to .env in the repo root. Shared by all three samples.
# Offline mock needs no key; set DEMO_MODE=adk to call Gemini.
DEMO_MODE=mock
GOOGLE_API_KEY=replace-with-your-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Model: samples 1-2 read ADK_MODEL, sample 3 reads MODEL.
ADK_MODEL=gemini-2.5-flash
MODEL=gemini-2.5-flash
